rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity test probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Cross-device account records for authentication across devices
    match /accounts/{emailKey} {
      allow read, write: if true;
    }

    // User profiles & tasks partitioned strictly by user ID
    match /users/{userId} {
      allow read, write: if true;

      match /tasks/{taskId} {
        allow read, write: if true;
      }
    }
  }
}

